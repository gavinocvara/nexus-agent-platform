{
  "schema_version": 1,
  "id": "orders_database_unavailable",
  "title": "Orders database unavailable",
  "description": "Orders simulates loss of usable PostgreSQL access without mutating data or schema.",
  "target": {"service": "orders", "dependency": "postgres"},
  "fault": {"type": "dependency_unavailable"},
  "expected_root_cause": {
    "component": "postgres",
    "failure": "unavailable to orders"
  },
  "expected_symptoms": [
    {
      "description": "Orders health reports its database unhealthy",
      "via": "orders",
      "method": "GET",
      "path": "/health",
      "expected_status": 503
    },
    {
      "description": "Gateway order creation reports dependency failure",
      "via": "gateway",
      "method": "POST",
      "path": "/orders",
      "expected_status": 503,
      "request_body": {"user_id": 1, "item": "scenario-probe", "quantity": 1}
    }
  ],
  "expected_unaffected_components": ["gateway process", "users", "existing order data"],
  "activation": {
    "controller_service": "orders",
    "failure_id": "orders_database_unavailable"
  },
  "recovery": {"reset_required": true, "health_service": "orders", "expected_status": 200},
  "tags": ["orders", "postgres", "dependency", "availability"],
  "difficulty": "intermediate"
}
