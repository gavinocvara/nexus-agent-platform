# NEXUS local development defaults.
# Copy to .env for local-only overrides. Never commit secrets.

NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_LAB_FAILURES_ENABLED=false
NEXUS_METRICS_ENABLED=false
NEXUS_OTEL_ENABLED=false
NEXUS_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# Host-side read-only diagnostic backend locations.
NEXUS_DIAGNOSTICS_GATEWAY_URL=http://localhost:8000
NEXUS_DIAGNOSTICS_USERS_URL=http://localhost:8001
NEXUS_DIAGNOSTICS_ORDERS_URL=http://localhost:8002
NEXUS_DIAGNOSTICS_PROMETHEUS_URL=http://localhost:9090
NEXUS_DIAGNOSTICS_LOKI_URL=http://localhost:3100
NEXUS_DIAGNOSTICS_TEMPO_URL=http://localhost:3200
NEXUS_DIAGNOSTICS_TIMEOUT_SECONDS=5
NEXUS_DIAGNOSTICS_MAX_RESPONSE_BYTES=1000000

# AegisOps investigator execution is opt-in. OPENAI_API_KEY belongs only in .env.
NEXUS_AGENT_ENABLED=false
NEXUS_AGENT_MODEL=gpt-5-mini
NEXUS_AGENT_MAX_TURNS=10
NEXUS_AGENT_TIMEOUT_SECONDS=120
NEXUS_AGENT_MAX_TOOL_CALLS=12
NEXUS_AGENT_SDK_TRACING_ENABLED=false
# OPENAI_API_KEY=

# PatchForge live engine (Milestone I) is opt-in; a run also needs --confirm-live.
NEXUS_PATCHFORGE_LIVE_ENABLED=false
NEXUS_PATCHFORGE_LIVE_MODEL=gpt-5.6-sol
NEXUS_PATCHFORGE_LIVE_MAX_MODEL_CALLS=40
NEXUS_PATCHFORGE_LIVE_MAX_OUTPUT_TOKENS=1024
NEXUS_PATCHFORGE_LIVE_TIMEOUT_SECONDS=60

# Resident Software Engineer (ADR 0012) is disabled by default and plans only in dry_run.
# Modes: dry_run, propose, autonomous_low_risk. The Slack webhook URL is a secret: set it
# only in the process environment or a CI secret, never here or in Git.
NEXUS_SOFTWARE_ENGINEER_ENABLED=false
NEXUS_SOFTWARE_ENGINEER_MODE=dry_run
NEXUS_SOFTWARE_ENGINEER_OWNER_ID=owner
NEXUS_SOFTWARE_ENGINEER_REPOSITORY_URL=https://github.com/gavinocvara/nexus-agent-platform
# Sandbox for mechanical recipes: none (plan only) or local_process (ephemeral, credential-free
# runners such as GitHub Actions only; it has no container isolation).
NEXUS_SOFTWARE_ENGINEER_SANDBOX=none
# Model recipes (type and micro-bug fixes) spend money only when ALL of these hold: a model,
# an explicit confirmation, positive call and token budgets, and OPENAI_API_KEY in the
# environment. Defaults keep them approval-only plans.
# NEXUS_SOFTWARE_ENGINEER_MODEL=gpt-5.6-sol
NEXUS_SOFTWARE_ENGINEER_CONFIRM_MODEL_SPEND=false
NEXUS_SOFTWARE_ENGINEER_MAX_MODEL_CALLS=0
NEXUS_SOFTWARE_ENGINEER_MAX_OUTPUT_TOKENS=0
NEXUS_SOFTWARE_ENGINEER_STATE_ROOT=.nexus/software_engineer
NEXUS_SOFTWARE_ENGINEER_MEMORY_PATH=.nexus/software_engineer/memory.sqlite3
NEXUS_SOFTWARE_ENGINEER_MAX_RUNTIME_SECONDS=1800
NEXUS_SOFTWARE_ENGINEER_MAX_CHANGED_FILES=5
NEXUS_SOFTWARE_ENGINEER_MAX_DIFF_BYTES=20000
# NEXUS_SOFTWARE_ENGINEER_SLACK_WEBHOOK_URL=
# Publishing (0.24.0): `decide` records the owner's SHIP/REVISE/REJECT; `publish` opens a
# DRAFT pull request (never a merge) with a fine-grained GitHub token that exists only in
# the environment: contents + pull requests write on this repository, nothing else.
# PUBLISH_FROM_CYCLE lets an autonomous_low_risk cycle open draft PRs itself; keep it false.
# NEXUS_SOFTWARE_ENGINEER_GITHUB_TOKEN=
NEXUS_SOFTWARE_ENGINEER_PUBLISH_FROM_CYCLE=false
# Issue intake is the engineer's only network read: open issues become untrusted signals.
NEXUS_SOFTWARE_ENGINEER_READ_ISSUES=false
NEXUS_SOFTWARE_ENGINEER_MAX_ISSUES=20
# NEXUS_SOFTWARE_ENGINEER_GITHUB_READ_TOKEN=

# Agent-private Brain modes: disabled, learn, or frozen_eval.
NEXUS_BRAIN_MODE=disabled
NEXUS_BRAIN_NAMESPACE=aegisops.investigator
NEXUS_BRAIN_PATH=.nexus/brain/aegisops-investigator.sqlite3
NEXUS_BRAIN_MAX_RETRIEVED_MEMORIES=3
NEXUS_BRAIN_MAX_CONTEXT_TOKENS=800
NEXUS_BRAIN_MAX_CONTEXT_CHARS=3200
NEXUS_BRAIN_MAX_AGE_DAYS=365
NEXUS_BRAIN_RETRIEVAL_TIMEOUT_SECONDS=2
NEXUS_BRAIN_PREREGISTRATION_PATH=docs/experiments/brain-v1-protocol.json
# NEXUS_BRAIN_EXPECTED_SNAPSHOT_SHA256=

# Local, ignored AegisOps benchmark history and environment stabilization.
NEXUS_BENCHMARK_ROOT=.nexus/benchmarks/aegisops
NEXUS_BENCHMARK_WARMUP_SECONDS=6
NEXUS_BENCHMARK_STACK_TIMEOUT_SECONDS=180

# Local Atlas job, idempotency, and append-only audit persistence.
NEXUS_ATLAS_DATABASE_PATH=.nexus/atlas/atlas.sqlite3

# Local Docker Compose database values. Replace them in your untracked .env.
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-local-only
