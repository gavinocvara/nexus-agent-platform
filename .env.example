# NEXUS local development defaults.
# Copy to .env for local-only overrides. Never commit secrets.

NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_LAB_FAILURES_ENABLED=false
NEXUS_METRICS_ENABLED=false
NEXUS_OTEL_ENABLED=false
NEXUS_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# Host-side read-only diagnostic backend locations.
NEXUS_DIAGNOSTICS_GATEWAY_URL=http://localhost:8000
NEXUS_DIAGNOSTICS_USERS_URL=http://localhost:8001
NEXUS_DIAGNOSTICS_ORDERS_URL=http://localhost:8002
NEXUS_DIAGNOSTICS_PROMETHEUS_URL=http://localhost:9090
NEXUS_DIAGNOSTICS_LOKI_URL=http://localhost:3100
NEXUS_DIAGNOSTICS_TEMPO_URL=http://localhost:3200
NEXUS_DIAGNOSTICS_TIMEOUT_SECONDS=5
NEXUS_DIAGNOSTICS_MAX_RESPONSE_BYTES=1000000

# Local Docker Compose database values. Replace them in your untracked .env.
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-local-only
