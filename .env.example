# NEXUS local development defaults.
# Copy to .env for local-only overrides. Never commit secrets.

NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_LAB_FAILURES_ENABLED=false
NEXUS_METRICS_ENABLED=false
NEXUS_OTEL_ENABLED=false
NEXUS_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# Host-side read-only diagnostic backend locations.
NEXUS_DIAGNOSTICS_GATEWAY_URL=http://localhost:8000
NEXUS_DIAGNOSTICS_USERS_URL=http://localhost:8001
NEXUS_DIAGNOSTICS_ORDERS_URL=http://localhost:8002
NEXUS_DIAGNOSTICS_PROMETHEUS_URL=http://localhost:9090
NEXUS_DIAGNOSTICS_LOKI_URL=http://localhost:3100
NEXUS_DIAGNOSTICS_TEMPO_URL=http://localhost:3200
NEXUS_DIAGNOSTICS_TIMEOUT_SECONDS=5
NEXUS_DIAGNOSTICS_MAX_RESPONSE_BYTES=1000000

# AegisOps investigator execution is opt-in. OPENAI_API_KEY belongs only in .env.
NEXUS_AGENT_ENABLED=false
NEXUS_AGENT_MODEL=gpt-5-mini
NEXUS_AGENT_MAX_TURNS=10
NEXUS_AGENT_TIMEOUT_SECONDS=120
NEXUS_AGENT_MAX_TOOL_CALLS=12
NEXUS_AGENT_SDK_TRACING_ENABLED=false
# OPENAI_API_KEY=

# Agent-private Brain modes: disabled, learn, or frozen_eval.
NEXUS_BRAIN_MODE=disabled
NEXUS_BRAIN_NAMESPACE=aegisops.investigator
NEXUS_BRAIN_PATH=.nexus/brain/aegisops-investigator.sqlite3
NEXUS_BRAIN_MAX_RETRIEVED_MEMORIES=3
NEXUS_BRAIN_MAX_CONTEXT_TOKENS=800
NEXUS_BRAIN_MAX_CONTEXT_CHARS=3200
NEXUS_BRAIN_MAX_AGE_DAYS=365
NEXUS_BRAIN_RETRIEVAL_TIMEOUT_SECONDS=2
NEXUS_BRAIN_PREREGISTRATION_PATH=docs/experiments/brain-v1-protocol.json
# NEXUS_BRAIN_EXPECTED_SNAPSHOT_SHA256=

# Local, ignored AegisOps benchmark history and environment stabilization.
NEXUS_BENCHMARK_ROOT=.nexus/benchmarks/aegisops
NEXUS_BENCHMARK_WARMUP_SECONDS=6
NEXUS_BENCHMARK_STACK_TIMEOUT_SECONDS=180

# Local Docker Compose database values. Replace them in your untracked .env.
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-local-only
