    "design": "leave_one_scenario_out",
    "fold_count": 5,
    "learning_runs_per_non_held_out_scenario": 2,
    "evaluation_runs_per_held_out_scenario_per_arm": 7,
    "arms": [
      "contemporaneous_memoryless",
      "held_out_frozen_brain",
      "length_matched_placebo"
