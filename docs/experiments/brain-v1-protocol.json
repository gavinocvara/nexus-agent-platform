    "ordering": "seeded_shuffle_and_interleaved_arms",
    "fold_guard": "No active snapshot record may map to the held-out scenario in the evaluator-only contamination ledger.",
    "primary_metric": "scenario_balanced_held_out_exact_diagnosis_accuracy",
    "must_not_regress": [
